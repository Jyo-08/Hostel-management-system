# Neo4j Connection Configuration (HostelOS BACSE202 DA3)
# For local Neo4j:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# For Neo4j Aura (Cloud):
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<aura_password>

# Application Configuration
HOSTELOS_DB_MODE=neo4j
BACKEND_PORT=8000
