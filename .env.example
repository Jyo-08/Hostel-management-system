# Neo4j Connection Configuration Template (HostelOS BACSE202 DA3)
# Copy this file to backend/.env and update with your actual credentials.
# NEVER commit .env to source control!

# Local Neo4j Community Server:
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# Neo4j Aura (Cloud):
# NEO4J_URI=neo4j+s://<dbid>.databases.neo4j.io
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<your_aura_password>

HOSTELOS_DB_MODE=neo4j
BACKEND_PORT=8000
